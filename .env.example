# ABOUTME: Copy to .env beside docker-compose.yml and fill in. .env is gitignored — keep it that way.

# --- Sync sidecar: Belphemur/obsidian-headless-sync-docker (wraps Obsidian's official `ob`) ---

# Pinned image tag. Note the container tags have NO leading 'v' (0.0.14), while that repo's git
# tags do (v0.0.14) — pinning the git tag form yields an image that does not exist. Watch
# github.com/Belphemur/obsidian-headless-sync-docker/releases; a new release is the cue to bump.
SYNC_IMAGE_TAG=0.0.14

# Obsidian account token. Mint once:
#   docker compose run --rm --entrypoint get-token obsidian-sync
# Treat like a password — full access to your Obsidian account.
OBSIDIAN_AUTH_TOKEN=

# Remote vault name, as it appears in Obsidian Sync.
VAULT_NAME=

# End-to-end encryption password, if your vault uses it.
VAULT_PASSWORD=

# Download-only, reverting local changes. Leave this set. The image's own default is empty,
# which means bidirectional — the container could push to every device you own.
SYNC_MODE=mirror-remote

# Folders never downloaded to this machine, comma-separated. With AI_FOLDER scoping (below),
# this is no longer what keeps notes from the agent — it keeps them off the NAS disk entirely.
# Set it for anything you would not want present on the machine at all.
# EXCLUDED_FOLDERS=Job Hunt,Ledger

# --- Scope: which single folder the MCP server can see ---------------------------------------
# The MCP container mounts ONLY this folder of the vault. The rest is not in its mount namespace,
# so it is absent rather than filtered — an allowlist, not an ignore list. Must match a folder
# name in the vault exactly, and must have synced before the MCP container starts.
AI_FOLDER=AI

# The MCP image. Pin to an immutable tag (or a digest) so `docker compose pull` cannot swap the
# running code without a visible change. `:deploy` moves and is fine for testing, not production.
MCP_IMAGE=ghcr.io/brandonm/obsidian-remote-mcp:sha-4085cd2
# Strictest form, if you want it:
# MCP_IMAGE=ghcr.io/brandonm/obsidian-remote-mcp@sha256:68bd89f6ca25ca62a87b8c36cdfd9a35d79f2c4cfff248eed1b9edd8adfaaba8

# Cloudflare Tunnel token. Zero Trust dashboard → Networks → Tunnels → create a tunnel → copy the
# token from the Docker install snippet. Then add a Public Hostname on that tunnel:
#   Subdomain/domain : whatever MCP_BASE_URL points at
#   Service          : HTTP  →  obsidian-mcp:3456
# Use the compose service name, not localhost — cloudflared runs in its own container.
# This token is a credential for your Cloudflare account. Treat it like a password.
TUNNEL_TOKEN=

# OAuth client id for the connector.
MCP_CLIENT_ID=

# The approval page is the entire gate on who gets a 30-day token. Rate limiting is roughly 100
# attempts per 15 minutes per IP, which stops a script and does nothing against a weak password
# attacked patiently. Generate, don't invent:
#   openssl rand -base64 32
APPROVAL_PASSWORD=

# The tunnel's public hostname — scheme and host, no /mcp path. Must match what clients see in
# the browser bar. Your connector URL is this plus /mcp.
MCP_BASE_URL=https://mcp.example.com

# Optional. Defaults are Claude-only, which is what you want unless you connect something else.
# MCP_CLIENT_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback
# CORS_ALLOWED_ORIGINS=https://claude.ai
